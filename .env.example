# Hugging Face Hub Token (required with write permissions for push_to_hub=True)
# Generate at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_huggingface_access_token_here

# Weights & Biases API Key (for tracking training metrics, loss, and hardware stats)
# Obtain at: https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_api_key_here

# Optional: Hugging Face Repository to push the trained LoRA adapter
HF_HUB_MODEL_ID=your-username/phi3-legal-clause-qlora
